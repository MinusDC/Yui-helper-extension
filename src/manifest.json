{
  "manifest_version": 3,
  "name": "ゆいちゃん",
  "version": "0.1.2",
  "description": "Translate selected Japanese text, see readings, furigana, and dictionary details. Made by MinusDC",
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://jisho.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ゆいちゃん　- Japanese Learning Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["kuromoji.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
